# ========================================================
# ELARA GRAND HOTEL & RESORT — ENVIRONMENT CONFIGURATION
# ========================================================

# Django Core Security Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to SQLite; toggle for MySQL)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Security & Tamper-Evident Hashing
AUDIT_HMAC_SECRET=your-cryptographic-hmac-sha256-salt-key-here

# OWASP A08: Webhook Secret for Payment Gateway Integration
RAZORPAY_WEBHOOK_SECRET=your-whsec-razorpay-or-stripe-secret

# Backup & Disaster Recovery Directory (Optional custom path)
BACKUP_DIR=backups/
